# Переменные окружения
#
# Онлайн-контур их не читает: `transportctl` настраивается флагами командной
# строки, и это сделано намеренно (ADR 0002) — флаги видны в `transportctl
# serve -h` и в строке запуска, а не разбросаны по окружению. Файл оставлен
# как точка расширения для Python-сервиса и docker-compose, которых в
# репозитории ещё нет. Пустые значения — это «не задано», а не «значение по
# умолчанию»: молчаливый default неправильного адреса хуже явной ошибки.

# ── Go · NDTP ingest ───────────────────────────────────────────
# Соответствует флагам: -listen, -plan, -binding, -tick, -grid, -jsonl
NDTP_LISTEN_HOST=0.0.0.0
NDTP_LISTEN_PORT=9201

# Расписание и привязка обязательны для прогноза: без них транспортное
# средство принимается, но цели у кадра не будет, и он не дойдёт до модели.
PLAN_CSV=
BINDING_CSV=

# Тик проверяет наступление границы ячейки, а не строит кадр: при тике 15 с и
# сетке 5 минут на ячейку приходится 20 проверок и один кадр (ADR 0007).
TICK_SECONDS=15
GRID_SECONDS=300

# Моменты прогноза лежат на сетке и округляются вниз. Данные кадра
# ограничены T по времени события и по времени приёма.

# ── Go · прогнозы и гейтвей ────────────────────────────────────
# Соответствует флагам: -http, -ml, -ml-timeout, -queue, -batch, -stats
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Адрес ML Core. Пусто — работает только baseline: delta_s = 0, то есть
# pred = cur_dev_s. Это осознанный режим работы, а не ошибка конфигурации.
ML_URL=http://127.0.0.1:8000
ML_PORT=8000

# Бюджет одной попытки модели; 0 — умолчание клиента. Очередь между
# конвейером и моделью ограничена: переполнение считается, но не блокирует
# приём телеметрии (ADR 0008).
ML_TIMEOUT_MS=
PREDICT_QUEUE=1024

# Кадры, дошедшие до воркера на одной границе сетки, уходят одним запросом
# `POST /predict/batch`. 1 — строго поштучно, полезно для отделения проблемы
# модели от проблемы батчинга: если поштучно работает, а батчем нет, дело в
# эндпоинте (ADR 0009).
PREDICT_BATCH=32

# ── Python · ML Core ───────────────────────────────────────────
ML_WORKERS=2
ML_MODEL_PATH=

# ── Dashboard ──────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── NDTP emulator ──────────────────────────────────────────────
NDTP_EMULATOR_PORT=18080

# ── Runtime ────────────────────────────────────────────────────
LOG_LEVEL=info
TZ=Europe/Moscow
