# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=transport
POSTGRES_PASSWORD=transport
POSTGRES_DB=transport
POSTGRES_PORT=5432

# ── Go · NDTP ingest ──────────────────────────────────────────
NDTP_LISTEN_HOST=0.0.0.0
NDTP_LISTEN_PORT=9201

# ── Go · API Gateway ──────────────────────────────────────────
GATEWAY_PORT=8080
GATEWAY_READ_TIMEOUT_S=10
GATEWAY_WRITE_TIMEOUT_S=15

# ── Python · ML Core ──────────────────────────────────────────
ML_PORT=8000
ML_WORKERS=2
ML_MODEL_PATH=/app/src/predictor/model.json

# ── Dashboard ─────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── NDTP emulator ─────────────────────────────────────────────
NDTP_EMULATOR_PORT=18080

# ── Pipeline ──────────────────────────────────────────────────
TICK_SECONDS=30
STALENESS_TTL_S=900
WINDOW_POINTS=90
HORIZON_MIN_S=600
HORIZON_MAX_S=900
INCIDENT_THRESHOLD_S=120

# ── Runtime ───────────────────────────────────────────────────
LOG_LEVEL=info
TZ=Europe/Moscow
