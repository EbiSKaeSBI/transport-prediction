# Скопировать в .env (файл в gitignore) и вписать свои значения.
# Фон карты по умолчанию — офлайн: тёмный холст + сетка координат,
# никаких внешних тайловых сервисов не нужно.
# Необязательный свой MapLibre style.json (со своими тайлами и подписями):
# VITE_MAP_STYLE=https://example.com/style.json
