# CatBoost пишет сюда дампы обучения при каждом fit, если ему не запретили
# запись (allow_writing_files=False). Обучение обязано быть безмолвным: иначе
# в рабочем дереве появляется мусор, который ничему не принадлежит.
catboost_info/

# Производные признаки — пересобираются из data/ одной командой
*.parquet
ml/data/
ml/artifacts/

# Логи
*.log
logs/

# Наблюдения телеметрии, которые пишет `transportctl serve` без
# --jsonl-out. Артефакт прогона, а не входные данные: при каждом старте
# сервера перезаписывается и в git попадать не должен.
observations.jsonl

# Бинарник, собираемый `make build` (backend/transportctl) — артефакт сборки.
backend/transportctl


